# LLM: set OPENAI_API_KEY and/or GOOGLE_API_KEY. If both are set, LLM_PROVIDER chooses
# (default openai). GEMINI_API_KEY is also accepted as an alias for GOOGLE_API_KEY.
# LLM_PROVIDER=gemini
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_HARD=gpt-4o
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite
GPLACES_API_KEY=your_google_places_api_key_here
FLASK_SECRET=change_me_to_any_random_string
FLASK_DEBUG=false
PG_USER=readonly_user
PG_PASSWORD=your_postgres_password
PG_HOST=localhost
PG_PORT=5432
PG_DB=condo_gpt
SQL_ROW_LIMIT=100
SQL_STATEMENT_TIMEOUT_MS=15000
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
PROMPT_VERSION=p1-v1
# API auth (required for /api/* when set)
API_KEY=your_shared_api_key_here
# Session cost budget (USD)
MAX_SESSION_COST_USD=0.50
# Semantic cache
CACHE_TTL_SECONDS=3600
CACHE_SIMILARITY_THRESHOLD=0.95
# Rate limit for /api/chat
RATE_LIMIT=30 per minute
# Maps API calls per session
MAPS_CALL_CAP=20
# Audit log path
AUDIT_LOG_PATH=logs/audit.jsonl
# LangSmith (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=miami-condo-gpt
